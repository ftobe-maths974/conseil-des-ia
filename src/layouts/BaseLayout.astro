---
interface Props {
  title: string;
  description?: string;
  mode?: 'groupe' | 'animateur';
}

const {
  title,
  description = 'Conseil des IA — Jeu pédagogique sur les enjeux de l\'intelligence artificielle',
  mode = 'groupe',
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} — Conseil des IA</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=DM+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />

    <!-- Global styles -->
    <style>
      @import '../styles/global.css';
    </style>
  </head>
  <body data-mode={mode}>
    <slot />
  </body>
</html>
