---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return [
    { params: { session: 'demo' } },
  ];
}

const { session } = Astro.params;
const bascules = await getCollection('bascules');
---

<BaseLayout title={`Animateur — ${session}`} mode="animateur">
  <main class="animateur">
    <header class="animateur__header">
      <h1 class="animateur__title">Conseil des IA</h1>
      <span class="animateur__session">Session : {session}</span>
    </header>

    <section class="animateur__deck">
      <h2>Cartes bascules ({bascules.length})</h2>
      <ul class="card-list">
        {bascules.map((b) => (
          <li class="card-item">
            <span class="card-item__id">{b.data.id}</span>
            <span class="card-item__title">{b.data.title}</span>
            <span class={`card-item__rev rev--${b.data.reversibility}`}>{b.data.reversibility}</span>
          </li>
        ))}
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .animateur {
    padding: var(--space-lg);
    max-width: 900px;
    margin: 0 auto;
  }

  .animateur__header {
    display: flex;
    align-items: baseline;
    gap: var(--space-lg);
    margin-bottom: var(--space-2xl);
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: var(--space-lg);
  }

  .animateur__title {
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 700;
  }

  .animateur__session {
    color: var(--text-muted);
    font-size: 0.9rem;
    font-family: var(--font-mono);
  }

  .animateur__deck h2 {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: var(--space-lg);
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .card-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .card-item {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md) var(--space-lg);
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .card-item__id {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    min-width: 8ch;
  }

  .card-item__title {
    flex: 1;
    font-size: 0.95rem;
  }

  .card-item__rev {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    font-weight: 600;
  }

  .rev--green { background: rgba(34,197,94,0.15); color: #16a34a; }
  .rev--yellow { background: rgba(234,179,8,0.15); color: #a16207; }
  .rev--red { background: rgba(239,68,68,0.15); color: #dc2626; }
</style>
