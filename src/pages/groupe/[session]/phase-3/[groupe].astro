---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { CHAMBER_LABELS, REV_LABELS } from '../../../../lib/chambers';


// ── Sélection par slot ────────────────────────────────────────────────────────
function selectActions(
  all: CollectionEntry<'actions'>[],
  chamber: string,
  deckId: string,
): CollectionEntry<'actions'>[] {
  return all
    .filter(a => a.id.startsWith(deckId + '/') && a.data.chamber === chamber)
    .sort((a, b) => a.data.slot - b.data.slot)
    .slice(0, 4);
}

// ── Routes statiques ──────────────────────────────────────────────────────
export async function getStaticPaths() {
  const allDecks = await getCollection('decks');
  return allDecks.flatMap(deck =>
    deck.data.groups.map(g => ({
      params: { session: deck.data.id, groupe: g.id },
      props: {
        chamber: g.chamber,
        nextGroupe: deck.data.mandat_circulation[g.id] ?? '',
      },
    }))
  );
}

// ── Données de la page ────────────────────────────────────────────────────
const { session, groupe } = Astro.params;
const { chamber, nextGroupe } = Astro.props;
const allActions = await getCollection('actions');
const selected = selectActions(allActions, chamber, session);

const allTensions = await getCollection('tensions');
type TensionReminder = { id: string; title: string; content: string; question: string; };
const tensionsReminder: TensionReminder[] = allTensions
  .filter(t => t.id.startsWith(session + '/') && t.data.chamber === chamber)
  .map(t => ({ id: t.data.id, title: t.data.title, content: t.data.content, question: t.data.question }));

type ActionData = {
  id: string;
  title: string;
  body: string;
  reversibility: string;
  scope: string;
  chamber: string;
  lever_type: string;
  tags: string[];
};

const actionsData: ActionData[] = selected.map(a => ({
  id: a.data.id,
  title: a.data.title,
  body: a.data.body,
  reversibility: a.data.reversibility,
  scope: a.data.scope,
  chamber: a.data.chamber,
  lever_type: a.data.lever_type,
  tags: a.data.tags,
}));

const phase4BaseUrl = `${import.meta.env.BASE_URL}/groupe/${session}/phase-4/${nextGroupe}`;
---

<BaseLayout title={`${groupe} — Phase 3`} mode="groupe">
  <main class="p3" data-groupe={groupe} data-session={session} data-next={nextGroupe}>

    <!-- En-tête -->
    <header class="p3__header">
      <div class="p3__header-left">
        <span class="p3__phase-label">Phase 3</span>
        <h1 class="p3__groupe">{groupe}</h1>
      </div>
      <span class="p3__chamber" data-chamber={chamber}>
        {CHAMBER_LABELS[chamber]}
      </span>
    </header>

    <!-- Instructions -->
    <section class="p3__instructions" id="p3-instructions">
      <p class="p3__instructions-text">
        Lisez les actions disponibles. Débattez et écartez celles qui vous semblent
        moins pertinentes — jusqu'à n'en garder <strong>qu'une seule</strong>.
        C'est cette action que vous transmettrez via QR code.
      </p>
    </section>

    <!-- Rappel dossier retenu Phase 2 -->
    <div class="p3__tension-reminder" id="p3-tension-reminder" hidden>
      <span class="p3__reminder-label">Dossier retenu en Phase 2</span>
      <h3 class="p3__tension-title" id="p3-tension-title"></h3>
      <p class="p3__tension-content" id="p3-tension-content"></p>
      <blockquote class="p3__tension-question" id="p3-tension-question"></blockquote>
    </div>

    <!-- Zone des actions écartées -->
    <div class="p3__discarded" id="p3-discarded" hidden>
      <p class="p3__discarded-label">Actions écartées</p>
    </div>

    <!-- Cartes action -->
    <section class="p3__cards" id="p3-cards" aria-label="Actions disponibles">
      {actionsData.map((action, i) => (
        <article class="p3-card" data-id={action.id} data-rev={action.reversibility} data-lever={action.lever_type}>
          <details class="p3-card__details">
            <summary class="p3-card__summary">
              <div class="p3-card__summary-inner">
                <span class="p3-card__num">{i + 1}</span>
                <h2 class="p3-card__title">{action.title}</h2>
                <span class="p3-card__recommended-badge" aria-hidden="true">★ Recommandé</span>
                <button class="p3-card__trash" type="button" aria-label="Écarter cette action">🗑</button>
                <button class="p3-card__recover" type="button" aria-label="Récupérer cette action">↩</button>
              </div>
            </summary>
            <div class="p3-card__expanded">
              <div class="p3-card__badges">
                <span class="rev-badge" data-rev={action.reversibility}>
                  {REV_LABELS[action.reversibility]}
                </span>
                <span class="p3-card__scope">{action.scope}</span>
              </div>
              <p class="p3-card__body">{action.body}</p>
              <div class="p3-card__tags" aria-hidden="true">
                {action.tags.map(tag => <span class="p3-card__tag">#{tag}</span>)}
              </div>
            </div>
          </details>
        </article>
      ))}
    </section>

    <!-- Bouton continuer (affiché quand 1 seule action reste) -->
    <section class="p3__continue" id="p3-continue" hidden>
      <button class="p3__generate-btn" id="p3-generate-btn">
        Générer le QR code →
      </button>
    </section>

    <!-- Panneau QR code -->
    <section class="p3__qr-panel" id="p3-qr-panel" hidden aria-live="polite">
      <div class="p3__qr-header">
        <span class="p3__qr-label">Mandat généré</span>
        <span class="p3__qr-dest" id="p3-qr-dest"></span>
      </div>
      <div class="p3__qr-card" id="p3-qr-card">
        <!-- rempli par le script -->
      </div>
      <div class="p3__qr-wrap">
        <canvas id="qr-canvas" class="p3__qr-canvas" aria-label="QR code du mandat"></canvas>
      </div>
      <div class="p3__qr-url-wrap">
        <code class="p3__qr-url" id="p3-qr-url"></code>
        <button class="p3__copy-btn" id="p3-copy-btn" aria-label="Copier le lien">
          Copier le lien
        </button>
      </div>
      <p class="p3__qr-instructions">
        Montrez ce QR code à {nextGroupe} — ils le scanneront pour démarrer leur Phase 4.
      </p>
    </section>

  </main>
</BaseLayout>

<!-- Données pour le script client -->
<script type="application/json" id="actions-data" set:html={JSON.stringify(actionsData)} />
<script type="application/json" id="phase4-base" set:html={JSON.stringify(phase4BaseUrl)} />
<script type="application/json" id="tensions-reminder" set:html={JSON.stringify(tensionsReminder)} />

<script>
  import QRCode from 'qrcode';
  import { REV_LABELS, DOMINANT_TO_LEVERS, clampTraj } from '../../../../lib/chambers';

  // ── Données ──────────────────────────────────────────────────────────────
  const actionsData: Array<{
    id: string; title: string; body: string;
    reversibility: string; scope: string; chamber: string; lever_type: string; tags: string[];
  }> = JSON.parse(document.getElementById('actions-data')!.textContent!);

  const phase4Base: string = JSON.parse(document.getElementById('phase4-base')!.textContent!);

  const tensionsReminder: Array<{ id: string; title: string; content: string; question: string; }> =
    JSON.parse(document.getElementById('tensions-reminder')!.textContent!);

  // ── Hash Phase 2 ──────────────────────────────────────────────────────────
  const hash = window.location.hash;

  const trajMatch = hash.match(/traj=([^&]+)/);
  let incomingTraj = parseInt(trajMatch?.[1] ?? '3', 10);
  if (isNaN(incomingTraj) || incomingTraj < 1 || incomingTraj > 5) incomingTraj = 3;

  const dominantMatch = hash.match(/dominant=([^&]+)/);
  const dominant = dominantMatch?.[1] ?? '';

  // Badge "Recommandé" selon le thème dominant de Phase 1
  if (dominant) {
    const recommended = DOMINANT_TO_LEVERS[dominant] ?? [];
    document.querySelectorAll<HTMLElement>('.p3-card[data-lever]').forEach(card => {
      if (recommended.includes(card.dataset.lever!)) {
        card.dataset.recommended = 'true';
      }
    });
  }

  // Afficher la carte de tension retenue (Phase 2)
  const tensionIdMatch = hash.match(/tensionId=([^&]+)/);
  if (tensionIdMatch) {
    const tensionId = decodeURIComponent(tensionIdMatch[1]);
    const tension = tensionsReminder.find(t => t.id === tensionId);
    if (tension) {
      document.getElementById('p3-tension-title')!.textContent    = tension.title;
      document.getElementById('p3-tension-content')!.textContent  = tension.content;
      document.getElementById('p3-tension-question')!.textContent = tension.question;
      document.getElementById('p3-tension-reminder')!.hidden = false;
    }
  }

  // ── Éléments DOM ─────────────────────────────────────────────────────────
  const cardsSection  = document.getElementById('p3-cards')!;
  const discardedZone = document.getElementById('p3-discarded')!;
  const continueSection = document.getElementById('p3-continue')!;
  const generateBtn   = document.getElementById('p3-generate-btn') as HTMLButtonElement;
  const qrPanel       = document.getElementById('p3-qr-panel')!;
  const qrDest        = document.getElementById('p3-qr-dest')!;
  const qrCardEl      = document.getElementById('p3-qr-card')!;
  const qrCanvas      = document.getElementById('qr-canvas') as HTMLCanvasElement;
  const qrUrlEl       = document.getElementById('p3-qr-url')!;
  const copyBtn       = document.getElementById('p3-copy-btn') as HTMLButtonElement;

  // ── Poubelle / récupération ───────────────────────────────────────────────
  function countActive(): number {
    return cardsSection.querySelectorAll('.p3-card:not([hidden])').length;
  }

  function renumberActive(): void {
    [...cardsSection.querySelectorAll<HTMLElement>('.p3-card:not([hidden])')].forEach((card, i) => {
      const num = card.querySelector<HTMLElement>('.p3-card__num');
      if (num) num.textContent = String(i + 1);
    });
  }

  function updateContinueVisibility(): void {
    continueSection.hidden = countActive() !== 1;
  }

  document.addEventListener('click', (e: Event) => {
    const target = e.target as HTMLElement;

    // ── Écarter ──────────────────────────────────────────────────────────────
    const trashBtn = target.closest<HTMLElement>('.p3-card__trash');
    if (trashBtn) {
      const card = trashBtn.closest<HTMLElement>('.p3-card');
      if (!card || countActive() <= 1) return;
      card.querySelector('details')?.removeAttribute('open');
      card.classList.add('p3-card--trashed');
      discardedZone.appendChild(card);
      discardedZone.hidden = false;
      renumberActive();
      updateContinueVisibility();
      return;
    }

    // ── Récupérer ─────────────────────────────────────────────────────────────
    const recoverBtn = target.closest<HTMLElement>('.p3-card__recover');
    if (recoverBtn) {
      const card = recoverBtn.closest<HTMLElement>('.p3-card');
      if (!card) return;
      card.classList.remove('p3-card--trashed');
      cardsSection.appendChild(card);
      if (discardedZone.querySelectorAll('.p3-card').length === 0) {
        discardedZone.hidden = true;
      }
      renumberActive();
      updateContinueVisibility();
    }
  });

  // ── Génération QR code ────────────────────────────────────────────────────
  generateBtn.addEventListener('click', async () => {
    const activeCards = [...cardsSection.querySelectorAll<HTMLElement>('.p3-card:not([hidden])')];
    if (activeCards.length !== 1) return;

    const actionId = activeCards[0].dataset.id!;
    const action = actionsData.find(a => a.id === actionId);
    if (!action) return;

    const trajDelta = action.reversibility === 'green' ? -1
                    : action.reversibility === 'red'   ?  1
                    :                                     0;
    const outTraj = clampTraj(incomingTraj + trajDelta);

    const tensionId = tensionIdMatch ? decodeURIComponent(tensionIdMatch[1]) : undefined;

    const handoff = {
      action:    { id: action.id, title: action.title },
      tensionId: tensionId || undefined,
      level:     action.reversibility,
      chamber:   action.chamber,
      from:      document.querySelector<HTMLElement>('.p3')!.dataset.groupe ?? '',
      traj:      outTraj,
    };

    const encoded = btoa(encodeURIComponent(JSON.stringify(handoff)));
    const fullUrl = `${window.location.origin}${phase4Base}#handoff=${encoded}`;

    // Remplir la carte récapitulative
    qrCardEl.innerHTML = `
      <div class="p3-qr-summary__meta">
        <span class="p3-card__id">${escHtml(action.id)}</span>
        <span class="rev-badge rev-badge--glow" data-rev="${escHtml(action.reversibility)}">
          ${escHtml(REV_LABELS[action.reversibility] ?? action.reversibility)}
        </span>
      </div>
      <h3 class="p3-qr-summary__title">${escHtml(action.title)}</h3>
      <p class="p3-qr-summary__body">${escHtml(action.body)}</p>
    `;

    // Destination
    const nextGroupe = document.querySelector<HTMLElement>('.p3')?.dataset.next ?? '';
    qrDest.textContent = `→ ${nextGroupe}`;

    // Générer le QR
    await QRCode.toCanvas(qrCanvas, fullUrl, {
      width: 240,
      margin: 2,
      color: { dark: '#f0f0f5', light: '#141420' },
    });

    qrUrlEl.textContent = fullUrl;

    // Afficher le panneau
    continueSection.hidden = true;
    document.getElementById('p3-instructions')!.hidden = true;
    qrPanel.hidden = false;
    qrPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  // ── Copier le lien ────────────────────────────────────────────────────────
  copyBtn.addEventListener('click', async () => {
    const url = qrUrlEl.textContent ?? '';
    try {
      await navigator.clipboard.writeText(url);
      copyBtn.textContent = 'Copié ✓';
      setTimeout(() => { copyBtn.textContent = 'Copier le lien'; }, 2000);
    } catch {
      copyBtn.textContent = 'Erreur';
    }
  });

  // ── Helpers ───────────────────────────────────────────────────────────────
  function escHtml(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;')
            .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }
</script>

<style>
  /* ── Layout ──────────────────────────────────────────────────────────────── */
  .p3 {
    min-height: 100dvh;
    padding: var(--space-lg);
    max-width: 600px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    padding-bottom: var(--space-3xl);
  }

  /* ── En-tête ─────────────────────────────────────────────────────────────── */
  .p3__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-md);
  }
  .p3__header-left { display: flex; flex-direction: column; gap: var(--space-xs); }
  .p3__phase-label {
    font-family: var(--font-mono); font-size: 0.75rem;
    color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.08em;
  }
  .p3__groupe { font-family: var(--font-display); font-size: 1.5rem; font-weight: 700; }
  .p3__chamber {
    font-size: 0.8rem; padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    border: 1px solid var(--chamber-color, var(--border-subtle));
    color: var(--chamber-color, var(--text-muted));
    text-align: right; max-width: 16ch; line-height: 1.3;
  }

  /* ── Instructions ────────────────────────────────────────────────────────── */
  .p3__instructions-text {
    font-size: 0.9rem; color: var(--text-secondary); line-height: 1.6;
    background: var(--bg-card); border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md); padding: var(--space-md) var(--space-lg);
  }

  /* ── Rappel dossier tension retenu ──────────────────────────────────────── */
  .p3__tension-reminder {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-left: 3px solid var(--chamber-color, var(--chamber-delegation));
    border-radius: var(--radius-md);
    padding: var(--space-md) var(--space-lg);
    display: flex; flex-direction: column; gap: var(--space-sm);
  }
  .p3__reminder-label {
    font-family: var(--font-mono); font-size: 0.68rem; font-weight: 700;
    color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.08em;
  }
  .p3__tension-title {
    font-family: var(--font-display); font-size: 0.95rem;
    font-weight: 600; line-height: 1.3; color: var(--text-primary);
  }
  .p3__tension-content {
    font-size: 0.85rem; color: var(--text-secondary); line-height: 1.55;
  }
  .p3__tension-question {
    font-size: 0.85rem; font-style: italic; color: var(--text-primary);
    border-left: 3px solid var(--border-subtle);
    padding-left: var(--space-sm); line-height: 1.5;
  }

  /* ── Zone actions écartées ───────────────────────────────────────────────── */
  .p3__discarded {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  .p3__discarded-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* ── Cartes accordion ────────────────────────────────────────────────────── */
  .p3__cards {
    display: flex; flex-direction: column; gap: var(--space-sm);
  }

  .p3-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color var(--transition-base);
  }
  .p3-card:has(details[open]) {
    border-color: var(--chamber-color, var(--border-subtle));
  }

  .p3-card__summary {
    list-style: none; cursor: pointer; padding: var(--space-lg); user-select: none;
  }
  .p3-card__summary::-webkit-details-marker { display: none; }
  .p3-card__summary:hover { background: var(--bg-card-hover); }

  .p3-card__summary-inner {
    display: flex; align-items: center; gap: var(--space-md);
  }

  .p3-card__num {
    font-family: var(--font-mono); font-size: 0.8rem;
    color: var(--text-muted); min-width: 1.5ch; flex-shrink: 0;
  }
  .p3-card__title {
    flex: 1; font-family: var(--font-display);
    font-size: 0.95rem; font-weight: 600; line-height: 1.3;
  }

  /* Badge Recommandé dans le summary */
  .p3-card__recommended-badge { display: none; }
  .p3-card[data-recommended="true"] .p3-card__recommended-badge {
    display: inline-flex; align-items: center; gap: 3px;
    font-family: var(--font-mono); font-size: 0.65rem; font-weight: 600;
    color: #f59e0b; background: rgba(245, 158, 11, 0.12);
    border: 1px solid rgba(245, 158, 11, 0.35);
    border-radius: var(--radius-sm); padding: 2px 6px; flex-shrink: 0;
  }
  .p3-card[data-recommended="true"] {
    border-color: rgba(245, 158, 11, 0.4);
  }

  /* ── Boutons poubelle / récupération ────────────────────────────────────── */
  .p3-card__trash,
  .p3-card__recover {
    background: none; border: none; cursor: pointer;
    font-size: 1rem; padding: 0.2rem 0.3rem;
    color: var(--text-muted); line-height: 1; flex-shrink: 0;
    transition: color var(--transition-fast), opacity var(--transition-fast);
    opacity: 0;
  }
  .p3-card:hover .p3-card__trash,
  .p3-card--trashed .p3-card__recover { opacity: 1; }
  .p3-card__trash:hover { color: var(--text-primary); }
  .p3-card__recover { display: none; }
  .p3-card--trashed .p3-card__trash   { display: none; }
  .p3-card--trashed .p3-card__recover { display: inline-flex; opacity: 1; }

  /* ── Carte écartée (compacte) ────────────────────────────────────────────── */
  .p3-card--trashed {
    opacity: 0.55;
    transition: opacity var(--transition-base);
  }
  .p3-card--trashed .p3-card__summary  { padding: var(--space-sm) var(--space-md); }
  .p3-card--trashed .p3-card__num,
  .p3-card--trashed .p3-card__recommended-badge { display: none; }
  .p3-card--trashed .p3-card__title    { font-size: 0.8rem; font-weight: 400; }
  .p3-card--trashed .p3-card__expanded { display: none; }

  /* ── Contenu déplié ──────────────────────────────────────────────────────── */
  .p3-card__expanded {
    padding: var(--space-md) var(--space-lg) var(--space-lg);
    border-top: 1px solid var(--border-subtle);
    display: flex; flex-direction: column; gap: var(--space-md);
  }
  .p3-card__badges { display: flex; gap: var(--space-xs); align-items: center; flex-wrap: wrap; }
  .p3-card__scope {
    font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-muted);
    background: rgba(255,255,255,0.04); border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm); padding: 2px 6px;
  }
  .p3-card__body { font-size: 0.85rem; color: var(--text-secondary); line-height: 1.55; }
  .p3-card__tags { display: flex; flex-wrap: wrap; gap: var(--space-xs); }
  .p3-card__tag {
    font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-muted);
    background: rgba(255,255,255,0.04); border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm); padding: 1px 6px;
  }
  .p3-card__id {
    font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-muted);
  }

  /* ── Bouton continuer ────────────────────────────────────────────────────── */
  .p3__continue[hidden] { display: none; }
  .p3__continue {
    display: flex;
    justify-content: center;
    padding-bottom: var(--space-2xl);
  }
  .p3__generate-btn {
    padding: var(--space-sm) var(--space-xl);
    background: var(--chamber-delegation); color: #fff;
    border: none; border-radius: var(--radius-md);
    font-family: var(--font-display); font-size: 0.95rem; font-weight: 600;
    cursor: pointer;
    transition: opacity var(--transition-fast), transform var(--transition-fast);
  }
  .p3__generate-btn:hover { opacity: 0.9; transform: translateY(-1px); }

  /* ── Panneau QR code ─────────────────────────────────────────────────────── */
  @keyframes reveal-in {
    from { opacity: 0; transform: translateY(20px) scale(0.98); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }

  .p3__qr-panel {
    display: flex; flex-direction: column; gap: var(--space-xl);
    padding-bottom: var(--space-3xl);
    animation: reveal-in 400ms ease both;
  }

  .p3__qr-header {
    display: flex; align-items: center; justify-content: space-between;
  }
  .p3__qr-label {
    font-family: var(--font-mono); font-size: 0.8rem;
    color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.08em;
  }
