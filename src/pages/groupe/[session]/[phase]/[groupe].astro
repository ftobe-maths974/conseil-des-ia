---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { CHAMBER_LABELS, REV_LABELS } from '../../../../lib/chambers';



// ── Sélection par slot ────────────────────────────────────────────────────────
function selectCards(
  all: CollectionEntry<'bascules'>[],
  chamber: string,
): CollectionEntry<'bascules'>[] {
  return all
    .filter(b => b.data.chamber === chamber)
    .sort((a, b) => a.data.slot - b.data.slot)
    .slice(0, 3);
}

// ── Routes statiques ──────────────────────────────────────────────────────────
export async function getStaticPaths() {
  const allDecks = await getCollection('decks');
  return allDecks.flatMap(deck =>
    deck.data.groups.map(g => ({
      params: { session: deck.data.id, phase: 'phase-1', groupe: g.id },
      props: { chamber: g.chamber },
    }))
  );
}

// ── Données de la page ────────────────────────────────────────────────────────
const { session, groupe } = Astro.params;
const { chamber } = Astro.props;
const allBascules = await getCollection('bascules');
const selected = selectCards(allBascules, chamber);

const phase2Url = `${import.meta.env.BASE_URL}/groupe/${session}/phase-2/${groupe}`;

type CardData = {
  id: string;
  title: string;
  situation: string;
  question: string;
  reversibility: string;
  chamber: string;
  slot_theme: string;
  tags: string[];
};

const cardsData: CardData[] = selected.map(b => ({
  id: b.data.id,
  title: b.data.title,
  situation: b.data.situation,
  question: b.data.question,
  reversibility: b.data.reversibility,
  chamber: b.data.chamber,
  slot_theme: b.data.slot_theme,
  tags: b.data.tags,
}));
---

<BaseLayout title={`${groupe} — Phase 1`} mode="groupe">
  <main class="p1" data-groupe={groupe} data-session={session}>

    <!-- En-tête -->
    <header class="p1__header">
      <div class="p1__header-left">
        <span class="p1__phase-label">Phase 1</span>
        <h1 class="p1__groupe">{groupe}</h1>
      </div>
      <span class="p1__chamber" data-chamber={chamber}>
        {CHAMBER_LABELS[chamber]}
      </span>
    </header>

    <!-- Instructions -->
    <section class="p1__instructions" id="instructions">
      <p class="p1__instructions-text">
        Lisez les 3 dossiers et rangez-les <strong>du plus réversible en haut</strong> au
        <strong>moins réversible en bas</strong>. Débattez entre vous — les badges de couleur
        sont des indices, pas la réponse.
      </p>
    </section>

    <!-- Pile de cartes -->
    <ol class="p1__stack" id="card-stack" aria-label="Classement des cartes">
      {cardsData.map((card, i) => (
        <li class="p1-card" data-id={card.id} data-rev={card.reversibility} data-theme={card.slot_theme}>
          <div class="p1-card__controls">
            <button class="p1-card__btn p1-card__btn--up" data-dir="up" aria-label="Monter cette carte">↑</button>
            <span class="p1-card__rank" aria-label={`Position ${i + 1}`}>{i + 1}</span>
            <button class="p1-card__btn p1-card__btn--down" data-dir="down" aria-label="Descendre cette carte">↓</button>
          </div>
          <details class="p1-card__details">
            <summary class="p1-card__summary">
              <span class="p1-card__id">{card.id}</span>
              <h2 class="p1-card__title">{card.title}</h2>
              <span class="p1-card__chevron" aria-hidden="true">›</span>
            </summary>
            <div class="p1-card__expanded">
              <span class="rev-badge" data-rev={card.reversibility}>{REV_LABELS[card.reversibility]}</span>
              <p class="p1-card__situation">{card.situation}</p>
              <blockquote class="p1-card__question">{card.question}</blockquote>
              <div class="p1-card__tags" aria-hidden="true">
                {card.tags.map(tag => <span class="p1-card__tag">#{tag}</span>)}
              </div>
            </div>
          </details>
        </li>
      ))}
    </ol>

    <!-- Pied de page actions -->
    <footer class="p1__footer" id="sort-footer">
      <p class="p1__footer-hint">Utilisez ↑ ↓ pour modifier le classement</p>
      <button class="p1__validate" id="btn-validate" disabled aria-disabled="true">
        Valider notre choix
      </button>
    </footer>

    <!-- Panneau de révélation (caché jusqu'à validation) -->
    <section class="p1__reveal" id="reveal-panel" hidden aria-live="polite">
      <div class="p1__reveal-header">
        <span class="p1__reveal-label">Votre carte la plus irréversible</span>
      </div>
      <div class="p1__reveal-card" id="reveal-card">
        <!-- rempli par le script -->
      </div>
      <div class="p1__reveal-actions">
        <a class="p1__continue" id="btn-continue" href={phase2Url}>
          Continuer vers la Phase 2 →
        </a>
      </div>
    </section>

  </main>
</BaseLayout>

<!-- Données pour le script client -->
<script type="application/json" id="cards-data" set:html={JSON.stringify(cardsData)} />

<script>
  import { REV_LABELS, initTraj, clampTraj } from '../../../../lib/chambers';
  // ── Lecture des données ────────────────────────────────────────────────────
  const rawData = document.getElementById('cards-data')?.textContent ?? '[]';
  const cards: Array<{
    id: string;
    title: string;
    situation: string;
    question: string;
    reversibility: string;
    chamber: string;
    tags: string[];
  }> = JSON.parse(rawData);

  // ── Éléments DOM ─────────────────────────────────────────────────────────
  const stack       = document.getElementById('card-stack') as HTMLOListElement;
  const validateBtn = document.getElementById('btn-validate') as HTMLButtonElement;
  const footer      = document.getElementById('sort-footer') as HTMLElement;
  const revealPanel = document.getElementById('reveal-panel') as HTMLElement;
  const revealCard  = document.getElementById('reveal-card') as HTMLElement;

  // ── État ──────────────────────────────────────────────────────────────────
  let hasMoved = false;

  // ── Helpers ───────────────────────────────────────────────────────────────
  function updateRanks(): void {
    stack.querySelectorAll<HTMLElement>('.p1-card').forEach((card, i) => {
      const rank = card.querySelector('.p1-card__rank');
      if (rank) rank.textContent = String(i + 1);
    });
  }

  function updateButtonStates(): void {
    const cards = stack.querySelectorAll<HTMLElement>('.p1-card');
    cards.forEach((card, i) => {
      const up   = card.querySelector<HTMLButtonElement>('[data-dir="up"]');
      const down = card.querySelector<HTMLButtonElement>('[data-dir="down"]');
      if (up)   { up.disabled   = i === 0;                 }
      if (down) { down.disabled = i === cards.length - 1;  }
    });
  }

  function bumpCard(card: HTMLElement): void {
    card.classList.remove('p1-card--moving');
    // Force reflow pour relancer l'animation
    void card.offsetWidth;
    card.classList.add('p1-card--moving');
    card.addEventListener('animationend', () => {
      card.classList.remove('p1-card--moving');
    }, { once: true });
  }

  // ── Gestion des déplacements ──────────────────────────────────────────────
  stack.addEventListener('click', (e: Event) => {
    const target = e.target as HTMLElement;
    const btn = target.closest<HTMLElement>('[data-dir]');
    if (!btn) return;

    const card = btn.closest<HTMLElement>('.p1-card');
    if (!card) return;

    const dir = btn.dataset.dir;
    if (dir === 'up' && card.previousElementSibling) {
      stack.insertBefore(card, card.previousElementSibling);
      bumpCard(card);
      hasMoved = true;
    } else if (dir === 'down' && card.nextElementSibling) {
      stack.insertBefore(card.nextElementSibling, card);
      bumpCard(card);
      hasMoved = true;
    }

    updateRanks();
    updateButtonStates();

    if (hasMoved) {
      validateBtn.disabled = false;
      validateBtn.removeAttribute('aria-disabled');
    }
  });

  // ── Validation ────────────────────────────────────────────────────────────
  validateBtn.addEventListener('click', () => {
    if (!hasMoved) return;

    const allCardEls = stack.querySelectorAll<HTMLElement>('.p1-card');
    const bottomCardEl = allCardEls[allCardEls.length - 1];
    if (!bottomCardEl) return;

    const cardId  = bottomCardEl.dataset.id ?? '';
    const cardRev = bottomCardEl.dataset.rev ?? 'yellow';
    const data    = cards.find(c => c.id === cardId);
    if (!data) return;

    // Construire le contenu de révélation
    const tagsHtml = data.tags
      .map(t => `<span class="p1-card__tag">#${t}</span>`)
      .join('');

    revealCard.innerHTML = `
      <div class="p1-card__meta">
        <span class="p1-card__id">${cardId}</span>
        <span class="rev-badge rev-badge--glow" data-rev="${cardRev}">
          ${REV_LABELS[cardRev] ?? cardRev}
        </span>
      </div>
      <h2 class="p1-card__title">${escHtml(data.title)}</h2>
      <p class="p1-card__situation">${escHtml(data.situation)}</p>
      <blockquote class="p1-card__question">${escHtml(data.question)}</blockquote>
      <div class="p1-card__tags" aria-hidden="true">${tagsHtml}</div>
    `;

    // Encoder les thèmes + trajectoire dans le lien "Continuer vers Phase 2"
    const allCardEls2 = stack.querySelectorAll<HTMLElement>('.p1-card');
    const dominant  = allCardEls2[allCardEls2.length - 1]?.dataset.theme ?? '';
    const secondary = allCardEls2.length >= 2 ? allCardEls2[allCardEls2.length - 2]?.dataset.theme ?? '' : '';
    const minor     = allCardEls2[0]?.dataset.theme ?? '';
    const bottomRev = allCardEls2[allCardEls2.length - 1]?.dataset.rev ?? 'yellow';
    const traj      = clampTraj(initTraj(bottomRev));
    const continueBtn = document.getElementById('btn-continue') as HTMLAnchorElement;
    if (continueBtn) {
      const base = continueBtn.getAttribute('href')!.split('#')[0];
      continueBtn.setAttribute('href', `${base}#dominant=${dominant}&secondary=${secondary}&minor=${minor}&traj=${traj}`);
    }

    // Transition : masquer tri, afficher révélation
    footer.hidden = true;
    stack.hidden = true;
    document.getElementById('instructions')!.hidden = true;
    revealPanel.hidden = false;
    revealPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  // ── Échappement HTML sûr ──────────────────────────────────────────────────
  function escHtml(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  // ── Initialisation ────────────────────────────────────────────────────────
  updateRanks();
  updateButtonStates();
</script>

<style>
  /* ── Layout principal ────────────────────────────────────────────────────── */
  .p1 {
    min-height: 100dvh;
    padding: var(--space-lg);
    max-width: 600px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  /* ── En-tête ─────────────────────────────────────────────────────────────── */
  .p1__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-md);
  }

  .p1__header-left {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .p1__phase-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .p1__groupe {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1;
  }

  .p1__chamber {
    font-size: 0.8rem;
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    border: 1px solid var(--chamber-color, var(--border-subtle));
    color: var(--chamber-color, var(--text-muted));
    text-align: right;
    max-width: 16ch;
    line-height: 1.3;
  }

  /* ── Instructions ────────────────────────────────────────────────────────── */
  .p1__instructions-text {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.6;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-md) var(--space-lg);
  }

  /* ── Pile de cartes ──────────────────────────────────────────────────────── */
  .p1__stack {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  /* ── Carte individuelle ──────────────────────────────────────────────────── */
  .p1-card {
    display: flex;
    gap: 0;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color var(--transition-base), box-shadow var(--transition-base);
  }

  .p1-card:focus-within {
    border-color: color-mix(in srgb, var(--text-muted) 60%, transparent);
  }

  /* Animation de déplacement */
  @keyframes card-bump {
    0%   { transform: scale(1);    box-shadow: none; }
    40%  { transform: scale(1.02); box-shadow: var(--shadow-card); }
    100% { transform: scale(1);    box-shadow: none; }
  }

  .p1-card--moving {
    animation: card-bump 220ms ease;
  }

  /* ── Contrôles ↑↓ ────────────────────────────────────────────────────────── */
  .p1-card__controls {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    flex-shrink: 0;
    padding: var(--space-md) var(--space-sm) var(--space-md) var(--space-md);
    border-right: 1px solid var(--border-subtle);
  }

  .p1-card__rank {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-muted);
    min-width: 1.5ch;
    text-align: center;
  }

  .p1-card__btn {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    cursor: pointer;
    font-size: 1rem;
    line-height: 1;
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background var(--transition-fast), color var(--transition-fast),
                border-color var(--transition-fast);
  }

  .p1-card__btn:hover:not(:disabled) {
    background: var(--bg-card-hover);
    color: var(--text-primary);
    border-color: var(--text-muted);
  }

  .p1-card__btn:disabled {
    opacity: 0.25;
    cursor: not-allowed;
  }

  /* ── Accordion de carte ──────────────────────────────────────────────────── */
  .p1-card__details {
    flex: 1;
    min-width: 0;
  }

  .p1-card__summary {
    list-style: none;
    cursor: pointer;
    user-select: none;
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md) var(--space-md);
    transition: background var(--transition-fast);
  }
  .p1-card__summary::-webkit-details-marker { display: none; }
  .p1-card__summary:hover,
  .p1-card__details[open] .p1-card__summary { background: var(--bg-card-hover); }

  .p1-card__id {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .p1-card__title {
    flex: 1;
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .p1-card__chevron {
    font-size: 1.1rem;
    color: var(--text-muted);
    flex-shrink: 0;
    transition: transform var(--transition-fast);
  }
  .p1-card__details[open] .p1-card__chevron { transform: rotate(90deg); }

  /* ── Contenu déplié ──────────────────────────────────────────────────────── */
  .p1-card__expanded {
    padding: var(--space-md) var(--space-md) var(--space-md);
    border-top: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .p1-card__situation {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .p1-card__question {
    font-size: 0.88rem;
    font-style: italic;
    color: var(--text-primary);
    border-left: 3px solid var(--border-subtle);
    padding-left: var(--space-sm);
    line-height: 1.5;
  }

  .p1-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .p1-card__tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 1px 6px;
  }

  /* ── Pied de page ────────────────────────────────────────────────────────── */
  .p1__footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    padding-bottom: var(--space-2xl);
  }

  .p1__footer-hint {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .p1__validate {
    padding: var(--space-md) var(--space-2xl);
    background: var(--chamber-delegation);
    color: #fff;
    border: none;
    border-radius: var(--radius-md);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: opacity var(--transition-fast), transform var(--transition-fast);
  }

  .p1__validate:not(:disabled):hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .p1__validate:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  /* ── Panneau de révélation ───────────────────────────────────────────────── */
  @keyframes reveal-in {
    from { opacity: 0; transform: translateY(20px) scale(0.98); }
    to   { opacity: 1; transform: translateY(0)    scale(1);    }
  }

  .p1__reveal {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    padding-bottom: var(--space-3xl);
    animation: reveal-in 400ms ease both;
  }

  .p1__reveal-header {
    text-align: center;
  }

  .p1__reveal-label {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* La carte révélée réutilise les styles .p1-card__* mais sans les contrôles */
  .p1__reveal-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  /* Glow sur le badge de réversibilité dans la révélation */
  .p1__reveal-card .rev-badge--glow[data-rev="green"] {
    box-shadow: 0 0 16px rgba(34,  197, 94,  0.45);
  }
  .p1__reveal-card .rev-badge--glow[data-rev="yellow"] {
    box-shadow: 0 0 16px rgba(234, 179, 8,   0.45);
  }
  .p1__reveal-card .rev-badge--glow[data-rev="red"] {
    box-shadow: 0 0 16px rgba(239, 68,  68,  0.45);
  }

  .p1__reveal-actions {
    text-align: center;
  }

  .p1__continue {
    display: inline-block;
    padding: var(--space-md) var(--space-2xl);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 500;
    transition: background var(--transition-fast), border-color var(--transition-fast),
                transform var(--transition-fast);
  }

  .p1__continue:hover {
    background: var(--bg-card-hover);
    border-color: var(--text-muted);
    transform: translateY(-1px);
  }
</style>
