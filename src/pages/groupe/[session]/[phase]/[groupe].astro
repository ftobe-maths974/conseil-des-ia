---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return [
    { params: { session: 'demo', phase: 'phase-1', groupe: 'groupe-A' } },
    { params: { session: 'demo', phase: 'phase-1', groupe: 'groupe-B' } },
    { params: { session: 'demo', phase: 'phase-1', groupe: 'groupe-C' } },
    { params: { session: 'demo', phase: 'phase-1', groupe: 'groupe-D' } },
  ];
}

const { session, phase, groupe } = Astro.params;
const bascules = await getCollection('bascules');
---

<BaseLayout title={`${groupe} — ${phase}`} mode="groupe">
  <main class="groupe">
    <header class="groupe__header">
      <div class="groupe__meta">
        <span class="groupe__label">{groupe}</span>
        <span class="groupe__phase">{phase}</span>
      </div>
      <span class="groupe__session">{session}</span>
    </header>

    <section class="groupe__cards">
      {bascules.map((b) => (
        <article class={`bascule-card bascule-card--${b.data.chamber}`}>
          <div class="bascule-card__header">
            <span class="bascule-card__id">{b.data.id}</span>
            <span class={`bascule-card__rev rev--${b.data.reversibility}`}>{b.data.reversibility}</span>
          </div>
          <h2 class="bascule-card__title">{b.data.title}</h2>
          <p class="bascule-card__situation">{b.data.situation}</p>
          <blockquote class="bascule-card__question">{b.data.question}</blockquote>
          <div class="bascule-card__tags">
            {b.data.tags.map((tag) => (
              <span class="tag">#{tag}</span>
            ))}
          </div>
        </article>
      ))}
    </section>
  </main>
</BaseLayout>

<style>
  .groupe {
    padding: var(--space-lg);
    max-width: 680px;
    margin: 0 auto;
  }

  .groupe__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-2xl);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--border-subtle);
  }

  .groupe__meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .groupe__label {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
  }

  .groupe__phase {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .groupe__session {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    padding: 4px 10px;
    border-radius: var(--radius-sm);
  }

  .groupe__cards {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .bascule-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
  }

  .bascule-card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-md);
  }

  .bascule-card__id {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .bascule-card__rev {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    font-weight: 600;
  }

  .rev--green { background: rgba(34,197,94,0.15); color: #16a34a; }
  .rev--yellow { background: rgba(234,179,8,0.15); color: #a16207; }
  .rev--red { background: rgba(239,68,68,0.15); color: #dc2626; }

  .bascule-card__title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.3;
    margin-bottom: var(--space-md);
  }

  .bascule-card__situation {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-md);
  }

  .bascule-card__question {
    font-size: 0.95rem;
    font-style: italic;
    color: var(--text-primary);
    border-left: 3px solid var(--chamber-delegation);
    padding-left: var(--space-md);
    margin: 0 0 var(--space-md);
    line-height: 1.5;
  }

  .bascule-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .tag {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
    background: var(--bg-subtle, rgba(255,255,255,0.05));
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
  }
</style>
