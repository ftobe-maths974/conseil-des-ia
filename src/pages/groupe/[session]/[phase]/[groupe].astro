---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { CHAMBER_LABELS, CHAMBER_ICONS, REV_LABELS } from '../../../../lib/chambers';



// ── Sélection par slot ────────────────────────────────────────────────────────
function selectCards(
  all: CollectionEntry<'bascules'>[],
  chamber: string,
  deckId: string,
): CollectionEntry<'bascules'>[] {
  return all
    .filter(b => b.id.startsWith(deckId + '/') && b.data.chamber === chamber)
    .sort((a, b) => a.data.slot - b.data.slot)
    .slice(0, 3);
}

// ── Routes statiques ──────────────────────────────────────────────────────────
export async function getStaticPaths() {
  const allDecks = await getCollection('decks');
  return allDecks.flatMap(deck =>
    deck.data.groups.map(g => ({
      params: { session: deck.data.id, phase: 'phase-1', groupe: g.id },
      props: { chamber: g.chamber },
    }))
  );
}

// ── Données de la page ────────────────────────────────────────────────────────
const { session, groupe } = Astro.params;
const { chamber } = Astro.props;
const allBascules = await getCollection('bascules');
const selected = selectCards(allBascules, chamber, session);

const phase2Url = `${import.meta.env.BASE_URL}/groupe/${session}/phase-2/${groupe}`;

type CardData = {
  id: string;
  title: string;
  situation: string;
  question: string;
  reversibility: string;
  chamber: string;
  slot_theme: string;
  tags: string[];
};

const cardsData: CardData[] = selected.map(b => ({
  id: b.data.id,
  title: b.data.title,
  situation: b.data.situation,
  question: b.data.question,
  reversibility: b.data.reversibility,
  chamber: b.data.chamber,
  slot_theme: b.data.slot_theme,
  tags: b.data.tags,
}));
---

<BaseLayout title={`${groupe} — Phase 1`} mode="groupe">
  <main class="p1" data-groupe={groupe} data-session={session}>

    <!-- En-tête -->
    <header class="p1__header">
      <div class="p1__header-left">
        <span class="p1__phase-label">Phase 1</span>
        <h1 class="p1__groupe">{groupe}</h1>
      </div>
      <span class="p1__chamber" data-chamber={chamber}>
        <span class="p1__chamber-icon" aria-hidden="true">{CHAMBER_ICONS[chamber]}</span>{CHAMBER_LABELS[chamber]}
      </span>
    </header>

    <!-- Instructions -->
    <section class="p1__instructions" id="instructions">
      <p class="p1__instructions-text">
        Lisez les 3 situations. Classez-les : en haut, celle qui sera la plus difficile à rattraper si on laisse faire. Votre premier choix pèsera le plus pour la suite. Débattez vite, puis validez.
      </p>
    </section>

    <!-- Pile de cartes -->
    <ol class="p1__stack" id="card-stack" aria-label="Classement des cartes">
      {cardsData.map((card, i) => (
        <li class="p1-card" draggable="true" data-id={card.id} data-rev={card.reversibility} data-theme={card.slot_theme}>
          <div class="p1-card__handle" aria-hidden="true">
            <span class="p1-card__rank">{i + 1}</span>
            <span class="p1-card__grip">⠿</span>
          </div>
          <details class="p1-card__details">
            <summary class="p1-card__summary">
              <span class="p1-card__id">{card.id}</span>
              <h2 class="p1-card__title">{card.title}</h2>
              <span class="p1-card__chevron" aria-hidden="true">›</span>
            </summary>
            <div class="p1-card__expanded">
              <span class="rev-badge" data-rev={card.reversibility}>{REV_LABELS[card.reversibility]}</span>
              <p class="p1-card__situation">{card.situation}</p>
              <div class="p1-card__question-wrap">
                <button class="p1-card__question-toggle" aria-label="Révéler la question" aria-expanded="false">💡</button>
                <blockquote class="p1-card__question" hidden>{card.question}</blockquote>
              </div>
              <div class="p1-card__tags" aria-hidden="true">
                {card.tags.map(tag => <span class="p1-card__tag">#{tag}</span>)}
              </div>
            </div>
          </details>
        </li>
      ))}
    </ol>

    <!-- Pied de page actions -->
    <footer class="p1__footer" id="sort-footer">
      <p class="p1__footer-hint">Glissez les dossiers pour les classer</p>
      <div class="p1__confirm" id="p1-confirm" hidden role="alert">
        <p class="p1__confirm-text">Vous n'avez pas modifié l'ordre. Validez-vous le classement tel quel ?</p>
        <div class="p1__confirm-btns">
          <button class="p1__confirm-yes" id="p1-confirm-yes">Oui, valider</button>
          <button class="p1__confirm-no" id="p1-confirm-no">Non, je réorganise</button>
        </div>
      </div>
      <button class="p1__validate" id="btn-validate">
        Valider notre choix
      </button>
    </footer>

    <!-- Panneau de révélation (caché jusqu'à validation) -->
    <section class="p1__reveal" id="reveal-panel" hidden aria-live="polite">
      <div class="p1__reveal-header">
        <span class="p1__reveal-label">Résultat de votre classement</span>
      </div>
      <ol class="p1__reveal-list" id="reveal-list">
        <!-- rempli par le script -->
      </ol>
      <div class="p1__reveal-actions">
        <a class="p1__continue" id="btn-continue" href={phase2Url}>
          Continuer vers la Phase 2 →
        </a>
      </div>
    </section>

  </main>
</BaseLayout>

<!-- Données pour le script client -->
<script type="application/json" id="cards-data" set:html={JSON.stringify(cardsData)} />

<script>
  import { REV_LABELS, initTraj, clampTraj } from '../../../../lib/chambers';
  // ── Lecture des données ────────────────────────────────────────────────────
  const rawData = document.getElementById('cards-data')?.textContent ?? '[]';
  const cards: Array<{
    id: string;
    title: string;
    situation: string;
    question: string;
    reversibility: string;
    chamber: string;
    tags: string[];
  }> = JSON.parse(rawData);

  // ── Éléments DOM ─────────────────────────────────────────────────────────
  const stack       = document.getElementById('card-stack') as HTMLOListElement;
  const validateBtn = document.getElementById('btn-validate') as HTMLButtonElement;
  const footer      = document.getElementById('sort-footer') as HTMLElement;
  const revealPanel = document.getElementById('reveal-panel') as HTMLElement;
  const revealList  = document.getElementById('reveal-list') as HTMLElement;

  // ── État ──────────────────────────────────────────────────────────────────
  let hasMoved = false;
  const confirmBox  = document.getElementById('p1-confirm')!;
  const confirmYes  = document.getElementById('p1-confirm-yes') as HTMLButtonElement;
  const confirmNo   = document.getElementById('p1-confirm-no') as HTMLButtonElement;

  // ── Helpers ───────────────────────────────────────────────────────────────
  function updateRanks(): void {
    stack.querySelectorAll<HTMLElement>('.p1-card').forEach((card, i) => {
      const rank = card.querySelector('.p1-card__rank');
      if (rank) rank.textContent = String(i + 1);
    });
  }

  function markMoved(): void {
    hasMoved = true;
    confirmBox.hidden = true;
  }

  // ── Drag and drop (souris) ────────────────────────────────────────────────
  let draggedEl: HTMLElement | null = null;

  stack.addEventListener('dragstart', (e: DragEvent) => {
    const card = (e.target as HTMLElement).closest<HTMLElement>('.p1-card');
    if (!card) return;
    draggedEl = card;
    e.dataTransfer!.effectAllowed = 'move';

    // Clone replié pour la ghost image — la carte ouverte serait trop grande
    const clone = card.cloneNode(true) as HTMLElement;
    clone.querySelector('details')?.removeAttribute('open');
    clone.style.cssText = `position:absolute;top:-9999px;width:${card.offsetWidth}px;`;
    document.body.appendChild(clone);
    e.dataTransfer!.setDragImage(clone, 24, 24);

    setTimeout(() => {
      card.querySelector('details')?.removeAttribute('open');
      card.classList.add('p1-card--dragging');
      document.body.removeChild(clone);
    }, 0);
  });

  stack.addEventListener('dragend', () => {
    draggedEl?.classList.remove('p1-card--dragging');
    draggedEl = null;
  });

  stack.addEventListener('dragover', (e: DragEvent) => {
    e.preventDefault();
    if (!draggedEl) return;
    const target = (e.target as HTMLElement).closest<HTMLElement>('.p1-card');
    if (!target || target === draggedEl) return;
    const rect = target.getBoundingClientRect();
    if (e.clientY < rect.top + rect.height / 2) {
      stack.insertBefore(draggedEl, target);
    } else {
      stack.insertBefore(draggedEl, target.nextElementSibling);
    }
    updateRanks();
    markMoved();
  });

  stack.addEventListener('drop', (e: DragEvent) => e.preventDefault());

  // ── Glisser-déposer tactile (mobile) ─────────────────────────────────────
  let touchCard: HTMLElement | null = null;

  stack.addEventListener('touchstart', (e: TouchEvent) => {
    const handle = (e.target as HTMLElement).closest<HTMLElement>('.p1-card__handle');
    if (!handle) return;
    touchCard = handle.closest<HTMLElement>('.p1-card');
    if (!touchCard) return;
    e.preventDefault();
    touchCard.querySelector('details')?.removeAttribute('open');
    touchCard.classList.add('p1-card--dragging');
  }, { passive: false });

  stack.addEventListener('touchmove', (e: TouchEvent) => {
    if (!touchCard) return;
    e.preventDefault();
    const y = e.touches[0].clientY;
    const siblings = [...stack.querySelectorAll<HTMLElement>('.p1-card')].filter(c => c !== touchCard);
    let inserted = false;
    for (const sibling of siblings) {
      const rect = sibling.getBoundingClientRect();
      if (y < rect.top + rect.height / 2) {
        stack.insertBefore(touchCard, sibling);
        inserted = true;
        break;
      }
    }
    if (!inserted) stack.appendChild(touchCard!);
    updateRanks();
    markMoved();
  }, { passive: false });

  stack.addEventListener('touchend', () => {
    touchCard?.classList.remove('p1-card--dragging');
    touchCard = null;
  });

  // ── Toggle question ───────────────────────────────────────────────────────
  stack.addEventListener('click', (e: Event) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('.p1-card__question-toggle');
    if (!btn) return;
    const question = btn.nextElementSibling as HTMLElement;
    const expanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!expanded));
    question.hidden = expanded;
  });

  // ── Validation ────────────────────────────────────────────────────────────
  function doValidate(): void {

    const allCardEls = [...stack.querySelectorAll<HTMLElement>('.p1-card')];

    // Position → réversibilité estimée par le groupe (haut = plus irréversible)
    const positionToRev: string[] = ['red', 'yellow', 'green'];

    revealList.innerHTML = allCardEls.map((cardEl, i) => {
      const cardId       = cardEl.dataset.id ?? '';
      const actualRev    = cardEl.dataset.rev ?? 'yellow';
      const estimatedRev = positionToRev[i] ?? 'yellow';
      const data         = cards.find(c => c.id === cardId);
      if (!data) return '';

      const isCorrect      = actualRev === estimatedRev;
      const actualLabel    = REV_LABELS[actualRev]    ?? actualRev;
      const estimatedLabel = REV_LABELS[estimatedRev] ?? estimatedRev;

      const verdict = isCorrect
        ? `Bravo — ce problème est effectivement <strong>${actualLabel}</strong>.`
        : `Vous avez estimé ce problème <strong>${estimatedLabel}</strong>, alors qu'il est <strong>${actualLabel}</strong>.`;

      return `
        <li class="p1__reveal-item ${isCorrect ? 'p1__reveal-item--correct' : 'p1__reveal-item--wrong'}">
          <span class="p1__reveal-rank">${i + 1}</span>
          <div class="p1__reveal-content">
            <p class="p1__reveal-title">${escHtml(data.title)}</p>
            <p class="p1__reveal-verdict">${verdict}</p>
          </div>
          <span class="rev-badge rev-badge--glow" data-rev="${actualRev}">${actualLabel}</span>
        </li>
      `;
    }).join('');

    // Encoder les thèmes + trajectoire dans le lien "Continuer vers Phase 2"
    const dominant  = allCardEls[0]?.dataset.theme ?? '';
    const secondary = allCardEls[1]?.dataset.theme ?? '';
    const minor     = allCardEls[allCardEls.length - 1]?.dataset.theme ?? '';
    const topRev    = allCardEls[0]?.dataset.rev ?? 'yellow';
    const traj      = clampTraj(initTraj(topRev));
    const continueBtn = document.getElementById('btn-continue') as HTMLAnchorElement;
    if (continueBtn) {
      const base = continueBtn.getAttribute('href')!.split('#')[0];
      continueBtn.setAttribute('href', `${base}#dominant=${dominant}&secondary=${secondary}&minor=${minor}&traj=${traj}`);
    }

    // Transition : masquer tri, afficher révélation
    footer.hidden = true;
    stack.hidden = true;
    document.getElementById('instructions')!.hidden = true;
    revealPanel.hidden = false;
    revealPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  validateBtn.addEventListener('click', () => {
    if (!hasMoved) {
      confirmBox.hidden = false;
      confirmBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      return;
    }
    doValidate();
  });

  confirmYes.addEventListener('click', () => doValidate());
  confirmNo.addEventListener('click', () => { confirmBox.hidden = true; });

  // ── Échappement HTML sûr ──────────────────────────────────────────────────
  function escHtml(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  // ── Initialisation ────────────────────────────────────────────────────────
  updateRanks();
</script>

<!-- Styles pour les éléments créés dynamiquement par JS (innerHTML) -->
<style is:global>
  /* Items de comparaison (créés par JS) */
  .p1__reveal-item {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-md) var(--space-lg);
  }
  .p1__reveal-item--correct {
    border-color: color-mix(in srgb, var(--rev-green) 35%, transparent);
  }
  .p1__reveal-item--wrong {
    border-color: color-mix(in srgb, var(--rev-yellow) 35%, transparent);
  }
  .p1__reveal-rank {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-muted);
    flex-shrink: 0;
    min-width: 1.5ch;
    text-align: center;
  }
  .p1__reveal-content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }
  .p1__reveal-title {
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--text-primary);
  }
  .p1__reveal-verdict {
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.45;
  }
  .p1__reveal-verdict strong {
    color: var(--text-primary);
    font-weight: 600;
  }
  /* Glow sur le badge dans les items */
  .p1__reveal-item .rev-badge--glow[data-rev="green"] {
    box-shadow: 0 0 12px rgba(34,  197, 94,  0.4);
  }
  .p1__reveal-item .rev-badge--glow[data-rev="yellow"] {
    box-shadow: 0 0 12px rgba(234, 179, 8,   0.4);
  }
  .p1__reveal-item .rev-badge--glow[data-rev="red"] {
    box-shadow: 0 0 12px rgba(239, 68,  68,  0.4);
  }
</style>

<style>
  /* ── Layout principal ────────────────────────────────────────────────────── */
  .p1 {
    min-height: 100dvh;
    padding: var(--space-lg);
    max-width: 600px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  /* ── En-tête ─────────────────────────────────────────────────────────────── */
  .p1__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-md);
  }

  .p1__header-left {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .p1__phase-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .p1__groupe {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1;
  }

  .p1__chamber {
    font-size: 0.8rem;
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    border: 1px solid var(--chamber-color, var(--border-subtle));
    color: var(--chamber-color, var(--text-muted));
    text-align: right;
    max-width: 16ch;
    line-height: 1.3;
  }

  /* ── Instructions ────────────────────────────────────────────────────────── */
  .p1__instructions-text {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.6;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-md) var(--space-lg);
  }

  /* ── Pile de cartes ──────────────────────────────────────────────────────── */
  .p1__stack {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  /* ── Carte individuelle ──────────────────────────────────────────────────── */
  .p1-card {
    display: flex;
    gap: 0;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color var(--transition-base), box-shadow var(--transition-base);
  }

  .p1-card:focus-within {
    border-color: color-mix(in srgb, var(--text-muted) 60%, transparent);
  }

  /* État pendant le drag */
  .p1-card--dragging {
    opacity: 0.35;
    border-style: dashed;
  }

  /* ── Handle drag ─────────────────────────────────────────────────────────── */
  .p1-card__handle {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    flex-shrink: 0;
    padding: var(--space-md) var(--space-sm) var(--space-md) var(--space-md);
    border-right: 1px solid var(--border-subtle);
    cursor: grab;
    touch-action: none;
    user-select: none;
  }

  .p1-card__handle:active {
    cursor: grabbing;
  }

  .p1-card__rank {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-muted);
    min-width: 1.5ch;
    text-align: center;
  }

  .p1-card__grip {
    font-size: 1rem;
    color: var(--text-muted);
    opacity: 0.45;
    line-height: 1;
  }

  /* ── Accordion de carte ──────────────────────────────────────────────────── */
  .p1-card__details {
    flex: 1;
    min-width: 0;
  }

  .p1-card__summary {
    list-style: none;
    cursor: pointer;
    user-select: none;
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md) var(--space-md);
    transition: background var(--transition-fast);
  }
  .p1-card__summary::-webkit-details-marker { display: none; }
  .p1-card__summary:hover,
  .p1-card__details[open] .p1-card__summary { background: var(--bg-card-hover); }

  .p1-card__id {
    display: none;
  }

  .p1-card__title {
    flex: 1;
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .p1-card__chevron {
    font-size: 1.1rem;
    color: var(--text-muted);
    flex-shrink: 0;
    transition: transform var(--transition-fast);
  }
  .p1-card__details[open] .p1-card__chevron { transform: rotate(90deg); }

  /* ── Contenu déplié ──────────────────────────────────────────────────────── */
  .p1-card__expanded {
    padding: var(--space-md) var(--space-md) var(--space-md);
    border-top: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  /* Badge de réversibilité caché pendant le tri — révélé uniquement dans le panneau de dévoilement */
  .p1-card__expanded .rev-badge {
    display: none;
  }

  .p1-card__situation {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .p1-card__question-wrap {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .p1-card__question-toggle {
    align-self: flex-start;
    background: none;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    cursor: pointer;
    font-size: 0.85rem;
    padding: 2px 8px;
    color: var(--text-muted);
    transition: border-color var(--transition-fast), opacity var(--transition-fast);
    opacity: 0.6;
  }
  .p1-card__question-toggle:hover { opacity: 1; border-color: var(--text-muted); }
  .p1-card__question-toggle[aria-expanded="true"] { opacity: 1; border-color: var(--text-muted); }

  .p1-card__question[hidden] { display: none; }
  .p1-card__question {
    font-size: 0.88rem;
    font-style: italic;
    color: var(--text-primary);
    border-left: 3px solid var(--border-subtle);
    padding-left: var(--space-sm);
    line-height: 1.5;
    margin: 0;
  }

  .p1-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .p1-card__tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 1px 6px;
  }

  /* ── Pied de page ────────────────────────────────────────────────────────── */
  .p1__footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    padding-bottom: var(--space-2xl);
  }

  .p1__footer-hint {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  /* ── Alerte confirmation sans drag ──────────────────────────────────────── */
  .p1__confirm[hidden] { display: none; }
  .p1__confirm {
    display: flex; flex-direction: column; gap: var(--space-sm);
    background: rgba(234,179,8,0.08);
