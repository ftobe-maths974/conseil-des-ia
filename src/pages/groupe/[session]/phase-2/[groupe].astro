---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { CHAMBER_LABELS, CHAMBER_ICONS, REV_LABELS } from '../../../../lib/chambers';



// ── Sélection : toutes les tensions de la chambre (max 9 = 3/thème) ──────────
function selectTensions(
  all: CollectionEntry<'tensions'>[],
  chamber: string,
  deckId: string,
): CollectionEntry<'tensions'>[] {
  return all
    .filter(t => t.id.startsWith(deckId + '/') && t.data.chamber === chamber)
    .sort((a, b) => a.data.slot - b.data.slot)
    .slice(0, 9);
}

// ── Routes statiques ──────────────────────────────────────────────────────
export async function getStaticPaths() {
  const allDecks = await getCollection('decks');
  return allDecks.flatMap(deck =>
    deck.data.groups.map(g => ({
      params: { session: deck.data.id, groupe: g.id },
      props: { chamber: g.chamber },
    }))
  );
}

// ── Données de la page ────────────────────────────────────────────────────
const { session, groupe } = Astro.params;
const { chamber } = Astro.props;
const allTensions = await getCollection('tensions');
const selected = selectTensions(allTensions, chamber, session);

const phase3Url = `${import.meta.env.BASE_URL}/groupe/${session}/phase-3/${groupe}`;

type TensionData = {
  id: string;
  title: string;
  content: string;
  data_point?: string;
  question: string;
  reversibility: string;
  slot_theme: string;
  tags: string[];
};

const tensionsData: TensionData[] = selected.map(t => ({
  id: t.data.id,
  title: t.data.title,
  content: t.data.content,
  data_point: t.data.data_point,
  question: t.data.question,
  reversibility: t.data.reversibility,
  slot_theme: t.data.slot_theme,
  tags: t.data.tags,
}));
---

<BaseLayout title={`${groupe} — Phase 2`} mode="groupe">
  <main class="p2" data-groupe={groupe} data-session={session}>

    <!-- En-tête -->
    <header class="p2__header">
      <div class="p2__header-left">
        <span class="p2__phase-label">Phase 2</span>
        <h1 class="p2__groupe">{groupe}</h1>
      </div>
      <span class="p2__chamber" data-chamber={chamber}>
        <span class="p2__chamber-icon" aria-hidden="true">{CHAMBER_ICONS[chamber]}</span>{CHAMBER_LABELS[chamber]}
      </span>
    </header>

    <!-- Instructions -->
    <section class="p2__instructions">
      <p class="p2__instructions-text">
        Lisez les dossiers de tension. Écartez ceux qui vous semblent secondaires
        jusqu'à n'en garder <strong>qu'un seul</strong>.
        C'est ce conflit central que vous transmettez à la phase suivante.
      </p>
    </section>

    <!-- Zone de dossiers écartés -->
    <div class="p2__discarded" id="p2-discarded" hidden>
      <p class="p2__discarded-label">Dossiers écartés</p>
    </div>

    <!-- Cartes tension -->
    <section class="p2__cards" id="p2-cards" aria-label="Dossiers de tension" style="visibility:hidden">
      {tensionsData.map((t, i) => (
        <article class="p2-card" data-id={t.id} data-rev={t.reversibility} data-slot-theme={t.slot_theme}>
          <details class="p2-card__details">
            <summary class="p2-card__summary">
              <div class="p2-card__summary-inner">
                <span class="p2-card__num">{i + 1}</span>
                <h2 class="p2-card__title">{t.title}</h2>
                <div class="p2-card__badges">
                  <span class="rev-badge" data-rev={t.reversibility}>
                    {REV_LABELS[t.reversibility]}
                  </span>
                </div>
                <button class="p2-card__trash" type="button" aria-label="Écarter ce dossier">🗑</button>
                <button class="p2-card__recover" type="button" aria-label="Récupérer ce dossier">↩</button>
              </div>
            </summary>
            <div class="p2-card__body">
              <p class="p2-card__content">{t.content}</p>
              {t.data_point && (
                <aside class="p2-card__data-point">
                  <span class="p2-card__data-label">Données</span>
                  <p>{t.data_point}</p>
                </aside>
              )}
              <div class="p2-card__question-wrap">
                <button class="p2-card__question-toggle" type="button" aria-expanded="false">💡</button>
                <blockquote class="p2-card__question" hidden>{t.question}</blockquote>
              </div>
              <div class="p2-card__tags" aria-hidden="true">
                {t.tags.map(tag => <span class="p2-card__tag">#{tag}</span>)}
              </div>
            </div>
          </details>
        </article>
      ))}
    </section>

    <!-- Bouton continuer (affiché quand 1 seule carte reste) -->
    <section class="p2__form" id="p2-form" hidden>
      <a class="p2__continue p2__continue--active" id="p2-continue" href={phase3Url}>
        Continuer vers la Phase 3 →
      </a>
    </section>

  </main>
</BaseLayout>

<!-- Données pour le script client -->
<script type="application/json" id="phase3-base" set:html={JSON.stringify(phase3Url)} />

<script>
  const continueA    = document.getElementById('p2-continue') as HTMLAnchorElement;
  const cardsSection = document.getElementById('p2-cards') as HTMLElement;

  const phase3Base: string = JSON.parse(document.getElementById('phase3-base')!.textContent!);

  // ── Lire le thème dominant + trajectoire depuis le hash Phase 1 ──────────
  const inHash = window.location.hash;
  const dominantMatch  = inHash.match(/dominant=([^&]+)/);
  const secondaryMatch = inHash.match(/secondary=([^&]+)/);
  const minorMatch     = inHash.match(/minor=([^&]+)/);
  const trajMatch      = inHash.match(/traj=([^&]+)/);
  const dominant  = dominantMatch?.[1]  ?? '';
  const secondary = secondaryMatch?.[1] ?? '';
  const minor     = minorMatch?.[1]     ?? '';
  let   traj      = parseInt(trajMatch?.[1] ?? '3', 10);
  if (isNaN(traj) || traj < 1 || traj > 5) traj = 3;

  // ── Poubelle / récupération ────────────────────────────────────────────────
  let orderedCards: HTMLElement[] = [];

  // ── Filtrage + réordonnancement 3/1/1 côté client ────────────────────────
  if (cardsSection) {
    const cards = Array.from(cardsSection.querySelectorAll<HTMLElement>('.p2-card'));

    let selected: HTMLElement[];
    if (dominant) {
      const byTheme = (theme: string) => cards.filter(c => c.dataset.slotTheme === theme);
      const dominantCards  = byTheme(dominant).slice(0, 3);
      const secondaryCards = byTheme(secondary).slice(0, 1);
      const minorCards     = byTheme(minor).slice(0, 1);
      selected = [...dominantCards, ...secondaryCards, ...minorCards];
      // Compléter jusqu'à 5 si certains thèmes manquent de cartes
      const selectedSet = new Set(selected);
      cards.filter(c => !selectedSet.has(c)).forEach(c => {
        if (selected.length < 5) selected.push(c);
      });
      // Masquer les cartes non sélectionnées (surplus des thèmes secondaires)
      const finalSet = new Set(selected);
      cards.filter(c => !finalSet.has(c)).forEach(c => { c.hidden = true; });
    } else {
      // Pas de hash : afficher les 5 premières seulement
      selected = cards.slice(0, 5);
      cards.slice(5).forEach(c => { c.hidden = true; });
    }

    // Trier du plus réversible (green) au plus irréversible (red)
    const revOrder: Record<string, number> = { green: 0, yellow: 1, red: 2 };
    selected.sort((a, b) => (revOrder[a.dataset.rev ?? ''] ?? 1) - (revOrder[b.dataset.rev ?? ''] ?? 1));

    // Réordonner dans le DOM sans FOUC (cardsSection était visible:hidden via CSS)
    selected.forEach(c => cardsSection.appendChild(c));
    // Renuméroter les positions visibles
    selected.forEach((el, i) => {
      const num = el.querySelector<HTMLElement>('.p2-card__num');
      if (num) num.textContent = String(i + 1);
    });

    cardsSection.style.visibility = 'visible';
    // Mémoriser l'ordre final pour la réintégration positionnée
    orderedCards = [...cardsSection.querySelectorAll<HTMLElement>('.p2-card')];

    // ── Confirmation de trajectoire (Phase 2) ────────────────────────────────
    // Si la majorité des 5 cartes visibles est red → traj + 1 (borné à 5)
    const visibleCards = selected; // tableau des 5 cartes affichées
    const redCount = visibleCards.filter(c => c.dataset.rev === 'red').length;
    if (redCount > visibleCards.length / 2) {
      traj = Math.min(5, traj + 1);
    }
  }


  // ── Poubelle / récupération ────────────────────────────────────────────────
  const discardedZone = document.getElementById('p2-discarded') as HTMLElement;
  const formSection   = document.getElementById('p2-form') as HTMLElement;
  let lastTensionId   = '';

  function countActive(): number {
    return cardsSection.querySelectorAll('.p2-card:not([hidden])').length;
  }

  function renumberActive(): void {
    [...cardsSection.querySelectorAll<HTMLElement>('.p2-card:not([hidden])')].forEach((card, i) => {
      const num = card.querySelector<HTMLElement>('.p2-card__num');
      if (num) num.textContent = String(i + 1);
    });
  }

  function updateFormVisibility(): void {
    const active = [...cardsSection.querySelectorAll<HTMLElement>('.p2-card:not([hidden])')];
    formSection.hidden = active.length !== 1;
    if (active.length === 1) {
      lastTensionId = active[0].dataset.id ?? '';
      const dominantSuffix = dominant ? `&dominant=${dominant}` : '';
      const tensionSuffix  = lastTensionId ? `&tensionId=${encodeURIComponent(lastTensionId)}` : '';
      continueA.href = `${phase3Base}#${dominantSuffix}&traj=${traj}${tensionSuffix}`.replace('#&', '#');
    } else {
      lastTensionId = '';
    }
  }

  document.addEventListener('click', (e: Event) => {
    const target = e.target as HTMLElement;

    // ── Toggle question (ampoule) ─────────────────────────────────────────────
    const toggleBtn = target.closest<HTMLElement>('.p2-card__question-toggle');
    if (toggleBtn) {
      e.stopPropagation();
      const question = toggleBtn.nextElementSibling as HTMLElement;
      const expanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!expanded));
      question.hidden = expanded;
      return;
    }

    // ── Écarter ──────────────────────────────────────────────────────────────
    const trashBtn = target.closest<HTMLElement>('.p2-card__trash');
    if (trashBtn) {
      const card = trashBtn.closest<HTMLElement>('.p2-card');
      if (!card || countActive() <= 1) return;
      card.querySelector('details')?.removeAttribute('open');
      card.classList.add('p2-card--trashed');
      discardedZone.appendChild(card);
      discardedZone.hidden = false;
      updateFormVisibility();
      return;
    }

    // ── Récupérer ─────────────────────────────────────────────────────────────
    const recoverBtn = target.closest<HTMLElement>('.p2-card__recover');
    if (recoverBtn) {
      const card = recoverBtn.closest<HTMLElement>('.p2-card');
      if (!card) return;
      card.classList.remove('p2-card--trashed');
      // Réinsérer à la position d'origine
      const idx = orderedCards.indexOf(card);
      const insertBefore = orderedCards.slice(idx + 1).find(c => c.parentElement === cardsSection) ?? null;
      cardsSection.insertBefore(card, insertBefore);
      if (discardedZone.querySelectorAll('.p2-card').length === 0) {
        discardedZone.hidden = true;
      }
      updateFormVisibility();
    }
  });
</script>

<style>
  /* ── Layout ──────────────────────────────────────────────────────────────── */
  .p2 {
    min-height: 100dvh;
    padding: var(--space-lg);
    max-width: 600px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    padding-bottom: var(--space-3xl);
  }

  /* ── En-tête ─────────────────────────────────────────────────────────────── */
  .p2__header {
    display: flex; justify-content: space-between;
    align-items: flex-start; gap: var(--space-md);
  }
  .p2__header-left { display: flex; flex-direction: column; gap: var(--space-xs); }
  .p2__phase-label {
    font-family: var(--font-mono); font-size: 0.75rem;
    color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.08em;
  }
  .p2__groupe { font-family: var(--font-display); font-size: 1.5rem; font-weight: 700; }
  .p2__chamber {
    font-size: 0.8rem; padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    border: 1px solid var(--chamber-color, var(--border-subtle));
    color: var(--chamber-color, var(--text-muted));
    text-align: right; max-width: 16ch; line-height: 1.3;
  }

  /* ── Instructions ────────────────────────────────────────────────────────── */
  .p2__instructions-text {
    font-size: 0.9rem; color: var(--text-secondary); line-height: 1.6;
    background: var(--bg-card); border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md); padding: var(--space-md) var(--space-lg);
  }

  /* ── Cartes accordion ────────────────────────────────────────────────────── */
  .p2__cards {
    display: flex; flex-direction: column; gap: var(--space-sm);
  }

  .p2-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color var(--transition-base);
  }
  .p2-card:has(details[open]) {
    border-color: var(--chamber-color, var(--border-subtle));
  }

  .p2-card__details { }

  .p2-card__summary {
    list-style: none;
    cursor: pointer;
    padding: var(--space-lg);
    user-select: none;
  }
  .p2-card__summary::-webkit-details-marker { display: none; }
  .p2-card__summary:hover { background: var(--bg-card-hover); }

  .p2-card__summary-inner {
    display: flex; align-items: center; gap: var(--space-md);
  }

  .p2-card__num {
    font-family: var(--font-mono); font-size: 0.8rem;
    color: var(--text-muted); min-width: 1.5ch;
    flex-shrink: 0;
  }
  .p2-card__title {
    flex: 1; font-family: var(--font-display);
    font-size: 0.95rem; font-weight: 600; line-height: 1.3;
  }
  .p2-card__badges { flex-shrink: 0; }

  .p2-card__body {
    padding: 0 var(--space-lg) var(--space-lg);
    display: flex; flex-direction: column; gap: var(--space-md);
    border-top: 1px solid var(--border-subtle);
    padding-top: var(--space-md);
  }
  .p2-card__content {
    font-size: 0.9rem; color: var(--text-secondary); line-height: 1.6;
  }
  .p2-card__data-point {
    background: var(--bg-surface); border-radius: var(--radius-md);
    padding: var(--space-md); display: flex; flex-direction: column; gap: var(--space-xs);
    border-left: 3px solid var(--chamber-color, var(--border-subtle));
  }
  .p2-card__data-label {
    font-family: var(--font-mono); font-size: 0.7rem;
    color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em;
  }
  .p2-card__data-point p { font-size: 0.85rem; color: var(--text-secondary); line-height: 1.55; }

  .p2-card__question-wrap {
    display: flex; flex-direction: column; gap: var(--space-xs);
  }
  .p2-card__question-toggle {
    background: none; border: none; cursor: pointer;
    font-size: 1rem; padding: 0; width: 2rem; height: 2rem;
    display: flex; align-items: center; justify-content: center;
    opacity: 0.5; transition: opacity var(--transition-fast);
    -webkit-tap-highlight-color: transparent;
  }
  .p2-card__question-toggle:active,
  .p2-card__question-toggle[aria-expanded="true"] { opacity: 1; }
  .p2-card__question[hidden] { display: none; }
  .p2-card__question {
    font-size: 0.9rem; font-style: italic; color: var(--text-primary);
    border-left: 3px solid var(--border-subtle);
    padding-left: var(--space-md); line-height: 1.5;
    margin: 0;
  }
  .p2-card__tags { display: flex; flex-wrap: wrap; gap: var(--space-xs); }
  .p2-card__tag {
    font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-muted);
    background: rgba(255,255,255,0.04); border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm); padding: 1px 6px;
  }

  /* ── Boutons poubelle / récupération ────────────────────────────────────── */
  .p2-card__trash,
  .p2-card__recover {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.1rem;
    min-width: 2.5rem;
    min-height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    flex-shrink: 0;
    transition: color var(--transition-fast);
    -webkit-tap-highlight-color: transparent;
  }
  .p2-card__trash:active,
  .p2-card__recover:active  { color: var(--text-primary); }
  .p2-card__recover { display: none; }
  .p2-card--trashed .p2-card__trash   { display: none; }
  .p2-card--trashed .p2-card__recover { display: flex; }

  /* ── Carte écartée (compacte) ────────────────────────────────────────────── */
  .p2-card--trashed {
    opacity: 0.55;
    transition: opacity var(--transition-base);
  }
  .p2-card--trashed .p2-card__summary { padding: var(--space-sm) var(--space-md); }
  .p2-card--trashed .p2-card__badges  { display: none; }
  .p2-card .rev-badge                 { display: none; }
  .p2-card--trashed .p2-card__title   { font-size: 0.8rem; font-weight: 400; }
  .p2-card--trashed .p2-card__body    { display: none; }

  /* ── Zone dossiers écartés ───────────────────────────────────────────────── */
  .p2__discarded[hidden] { display: none; }
  .p2__discarded {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  .p2__discarded-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* ── Bouton continuer ────────────────────────────────────────────────────── */
  .p2__form[hidden] { display: none; }
  .p2__form {
    display: flex;
    justify-content: center;
    padding-bottom: var(--space-2xl);
  }

  .p2__continue {
    display: inline-block;
    padding: var(--space-sm) var(--space-xl);
    background: var(--bg-surface); border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md); color: var(--text-muted);
    text-decoration: none; font-family: var(--font-display);
    font-size: 0.95rem; font-weight: 500;
    pointer-events: none;
    transition: background var(--transition-fast), border-color var(--transition-fast),
                color var(--transition-fast), transform var(--transition-fast);
  }
  .p2__continue--active {
    pointer-events: auto;
    background: var(--chamber-delegation); border-color: var(--chamber-delegation);
    color: #fff;
  }
  .p2__continue--active:hover {
    opacity: 0.9; transform: translateY(-1px);
  }
</style>
